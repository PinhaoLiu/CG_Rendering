#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct Material
{
	vec4 colour_reflectivity;
	vec4 optical;
};

struct Primitive
{
	vec4 p0;
	vec4 p1;
	vec4 p2;
	uvec4 metadata;
};

struct BvhNode
{
	vec4 minimum;
	vec4 maximum;
	uvec4 data;
};

layout(std430, binding = 0) readonly buffer PrimitiveBuffer
{
	Primitive primitives[];
};

layout(std430, binding = 1) readonly buffer MaterialBuffer
{
	Material materials[];
};

layout(std430, binding = 2) readonly buffer BvhNodeBuffer
{
	BvhNode nodes[];
};

layout(std430, binding = 3) readonly buffer PrimitiveIndexBuffer
{
	uint primitive_indices[];
};

layout(rgba32f, binding = 0) uniform writeonly image2D uOutput;

uniform ivec2 uResolution;
uniform vec2 uImageExtent;
uniform vec3 uEye;
uniform vec3 uForward;
uniform vec3 uRight;
uniform vec3 uUp;
uniform vec3 uLightPosition;
uniform int uMaximumDepth;
uniform int uSamplesPerAxis;

const uint SPHERE = 0u;
const float EPSILON = 0.01;
const float INFINITY_T = 3.402823466e+38;
const int MAX_BVH_STACK = 64;
const int MAX_RAY_TASKS = 16;

struct Ray
{
	vec3 origin;
	vec3 direction;
	float minimum_t;
	float maximum_t;
};

struct Hit
{
	vec3 position;
	vec3 normal;
	float t;
	uint material_index;
	bool front_facing;
};

struct RayTask
{
	Ray ray;
	float weight;
	int depth;
};

bool intersectBounds(Ray ray, vec3 minimum, vec3 maximum, float closest_t, out float near_t)
{
	float t_minimum = ray.minimum_t;
	float t_maximum = min(ray.maximum_t, closest_t);

	for (int axis = 0; axis < 3; ++axis) {
		float origin = ray.origin[axis];
		float direction = ray.direction[axis];
		if (abs(direction) < 1.0e-8) {
			if (origin < minimum[axis] || origin > maximum[axis])
				return false;
			continue;
		}

		float inverse_direction = 1.0 / direction;
		float t0 = (minimum[axis] - origin) * inverse_direction;
		float t1 = (maximum[axis] - origin) * inverse_direction;
		if (t0 > t1) {
			float temporary = t0;
			t0 = t1;
			t1 = temporary;
		}
		t_minimum = max(t_minimum, t0);
		t_maximum = min(t_maximum, t1);
		if (t_maximum < t_minimum)
			return false;
	}

	near_t = t_minimum;
	return true;
}

bool intersectPrimitive(Ray ray, uint primitive_index, float closest_t, out Hit hit)
{
	Primitive primitive = primitives[primitive_index];
	float t = INFINITY_T;
	vec3 geometric_normal = vec3(0.0);

	if (primitive.metadata.x == SPHERE) {
		vec3 centre = primitive.p0.xyz;
		float radius = primitive.p0.w;
		vec3 offset = ray.origin - centre;
		float a = dot(ray.direction, ray.direction);
		float half_b = dot(ray.direction, offset);
		float c = dot(offset, offset) - radius * radius;
		float discriminant = half_b * half_b - a * c;
		if (discriminant < 0.0)
			return false;

		float root = sqrt(discriminant);
		float t0 = (-half_b - root) / a;
		float t1 = (-half_b + root) / a;
		t = t0 >= ray.minimum_t ? t0 : t1;
		if (t < ray.minimum_t || t > ray.maximum_t || t >= closest_t)
			return false;
		geometric_normal = normalize(ray.origin + t * ray.direction - centre);
	} else {
		vec3 edge1 = primitive.p1.xyz - primitive.p0.xyz;
		vec3 edge2 = primitive.p2.xyz - primitive.p0.xyz;
		vec3 p = cross(ray.direction, edge2);
		float determinant = dot(edge1, p);
		if (abs(determinant) < 1.0e-6)
			return false;

		float inverse_determinant = 1.0 / determinant;
		vec3 origin_to_vertex = ray.origin - primitive.p0.xyz;
		float u = dot(origin_to_vertex, p) * inverse_determinant;
		if (u < 0.0 || u > 1.0)
			return false;
		vec3 q = cross(origin_to_vertex, edge1);
		float v = dot(ray.direction, q) * inverse_determinant;
		if (v < 0.0 || u + v > 1.0)
			return false;
		t = dot(edge2, q) * inverse_determinant;
		if (t < ray.minimum_t || t > ray.maximum_t || t >= closest_t)
			return false;
		geometric_normal = normalize(cross(edge1, edge2));
	}

	hit.t = t;
	hit.position = ray.origin + t * ray.direction;
	hit.front_facing = dot(-ray.direction, geometric_normal) > 0.0;
	hit.normal = hit.front_facing ? geometric_normal : -geometric_normal;
	hit.material_index = primitive.metadata.y;
	return true;
}

bool intersectScene(Ray ray, bool any_hit, out Hit closest_hit)
{
	float root_near = 0.0;
	if (!intersectBounds(ray, nodes[0].minimum.xyz, nodes[0].maximum.xyz,
	                     ray.maximum_t, root_near))
		return false;

	uint node_stack[MAX_BVH_STACK];
	float near_stack[MAX_BVH_STACK];
	int stack_size = 1;
	node_stack[0] = 0u;
	near_stack[0] = root_near;
	float closest_t = ray.maximum_t;
	bool found = false;

	while (stack_size > 0) {
		--stack_size;
		uint node_index = node_stack[stack_size];
		float node_near = near_stack[stack_size];
		if (node_near > closest_t)
			continue;

		BvhNode node = nodes[node_index];
		if (node.data.w > 0u) {
			for (uint i = 0u; i < node.data.w; ++i) {
				Hit candidate;
				uint primitive_index = primitive_indices[node.data.z + i];
				if (!intersectPrimitive(ray, primitive_index, closest_t, candidate))
					continue;
				if (any_hit) {
					closest_hit = candidate;
					return true;
				}
				closest_t = candidate.t;
				closest_hit = candidate;
				found = true;
			}
			continue;
		}

		float left_near = 0.0;
		float right_near = 0.0;
		bool hit_left = intersectBounds(ray, nodes[node.data.x].minimum.xyz,
		                                nodes[node.data.x].maximum.xyz, closest_t, left_near);
		bool hit_right = intersectBounds(ray, nodes[node.data.y].minimum.xyz,
		                                 nodes[node.data.y].maximum.xyz, closest_t, right_near);

		if (hit_left && hit_right && stack_size <= MAX_BVH_STACK - 2) {
			uint near_child = left_near < right_near ? node.data.x : node.data.y;
			uint far_child = left_near < right_near ? node.data.y : node.data.x;
			float near_distance = min(left_near, right_near);
			float far_distance = max(left_near, right_near);
			node_stack[stack_size] = far_child;
			near_stack[stack_size++] = far_distance;
			node_stack[stack_size] = near_child;
			near_stack[stack_size++] = near_distance;
		} else if (hit_left && stack_size < MAX_BVH_STACK) {
			node_stack[stack_size] = node.data.x;
			near_stack[stack_size++] = left_near;
		} else if (hit_right && stack_size < MAX_BVH_STACK) {
			node_stack[stack_size] = node.data.y;
			near_stack[stack_size++] = right_near;
		}
	}

	return found;
}

vec3 traceRay(Ray primary_ray)
{
	RayTask tasks[MAX_RAY_TASKS];
	int task_count = 1;
	tasks[0] = RayTask(primary_ray, 1.0, uMaximumDepth);
	vec3 radiance = vec3(0.0);

	while (task_count > 0) {
		RayTask task = tasks[--task_count];
		Hit hit;
		if (!intersectScene(task.ray, false, hit))
			continue;

		Material material = materials[hit.material_index];
		float reflectivity = material.colour_reflectivity.w;
		float transparency = material.optical.x;

		vec3 to_light = uLightPosition - hit.position;
		float light_distance = length(to_light);
		vec3 light_direction = to_light / light_distance;
		float diffuse = max(dot(hit.normal, light_direction), 0.0);
		Ray shadow_ray = Ray(hit.position + hit.normal * EPSILON, light_direction,
		                     EPSILON, light_distance - EPSILON);
		Hit shadow_hit;
		if (diffuse > 0.0 && intersectScene(shadow_ray, true, shadow_hit))
			diffuse = 0.0;

		float direct_weight = clamp(1.0 - reflectivity - transparency, 0.0, 1.0);
		radiance += task.weight * direct_weight * material.colour_reflectivity.rgb * diffuse;

		if (task.depth <= 0)
			continue;

		vec3 incoming = normalize(task.ray.direction);
		if (reflectivity > 0.0 && task_count < MAX_RAY_TASKS) {
			vec3 reflected = normalize(reflect(incoming, hit.normal));
			Ray reflected_ray = Ray(hit.position + hit.normal * EPSILON, reflected,
			                        EPSILON, INFINITY_T);
			tasks[task_count++] = RayTask(reflected_ray, task.weight * reflectivity, task.depth - 1);
		}

		if (transparency > 0.0 && task_count < MAX_RAY_TASKS) {
			float eta = hit.front_facing ? 1.0 / material.optical.y : material.optical.y;
			float cos_incident = -dot(incoming, hit.normal);
			float discriminant = 1.0 - eta * eta * (1.0 - cos_incident * cos_incident);
			vec3 refracted = discriminant < 0.0
				? normalize(reflect(incoming, hit.normal))
				: normalize(eta * incoming + (eta * cos_incident - sqrt(discriminant)) * hit.normal);
			vec3 offset_normal = dot(refracted, hit.normal) < 0.0 ? -hit.normal : hit.normal;
			Ray refracted_ray = Ray(hit.position + offset_normal * EPSILON, refracted,
			                        EPSILON, INFINITY_T);
			tasks[task_count++] = RayTask(refracted_ray, task.weight * transparency, task.depth - 1);
		}
	}

	return radiance;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, uResolution)))
		return;

	int sample_count_axis = clamp(uSamplesPerAxis, 1, 3);
	vec3 colour = vec3(0.0);
	for (int sample_y = 0; sample_y < sample_count_axis; ++sample_y) {
		for (int sample_x = 0; sample_x < sample_count_axis; ++sample_x) {
			vec2 sample_offset = (vec2(sample_x, sample_y) + vec2(0.5)) / float(sample_count_axis);
			vec2 image_position = (vec2(pixel) + sample_offset) / vec2(uResolution);
			vec2 screen = vec2(2.0 * image_position.x - 1.0, 1.0 - 2.0 * image_position.y);
			vec3 direction = normalize(uForward
			                         + screen.x * uImageExtent.x * uRight
			                         + screen.y * uImageExtent.y * uUp);
			colour += traceRay(Ray(uEye, direction, 0.0, INFINITY_T));
		}
	}
	colour /= float(sample_count_axis * sample_count_axis);
	imageStore(uOutput, pixel, vec4(colour, 1.0));
}
