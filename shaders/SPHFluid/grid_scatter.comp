#version 430

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer PositionBuffer { vec4 positions[]; };
layout(std430, binding = 5) readonly buffer CellCountBuffer { uint cellCounts[]; };
layout(std430, binding = 6) readonly buffer CellOffsetBuffer { uint cellOffsets[]; };
layout(std430, binding = 7) writeonly buffer ParticleIndexBuffer { uint particleIndices[]; };
layout(std430, binding = 10) buffer GridErrorBuffer { uint gridErrors[4]; };
layout(std430, binding = 11) buffer CellCursorBuffer { uint cellCursors[]; };

uniform uint uParticleCount;
uniform uvec3 uGridDimensions;
uniform vec3 uGridMinimum;
uniform float uGridCellSize;

uint flatten(uvec3 cell)
{
	return cell.x + uGridDimensions.x * (cell.y + uGridDimensions.y * cell.z);
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= uParticleCount)
		return;
	vec3 relative = (positions[i].xyz - uGridMinimum) / uGridCellSize;
	if (any(isnan(relative)) || any(isinf(relative)))
		return;
	ivec3 integer_cell = ivec3(floor(relative));
	integer_cell = clamp(integer_cell, ivec3(0), ivec3(uGridDimensions) - ivec3(1));
	uint cell = flatten(uvec3(integer_cell));
	uint destination = atomicAdd(cellCursors[cell], 1u);
	uint end = cellOffsets[cell] + cellCounts[cell];
	if (destination >= end || destination >= uParticleCount) {
		atomicAdd(gridErrors[1], 1u);
		return;
	}
	particleIndices[destination] = i;
}
