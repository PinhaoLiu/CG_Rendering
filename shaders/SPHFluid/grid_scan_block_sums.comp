#version 430

layout(local_size_x = 1) in;

layout(std430, binding = 8) readonly buffer BlockSumBuffer { uint blockSums[]; };
layout(std430, binding = 9) writeonly buffer BlockOffsetBuffer { uint blockOffsets[]; };

uniform uint uBlockCount;

void main()
{
	uint prefix = 0u;
	for (uint block = 0u; block < uBlockCount; ++block) {
		blockOffsets[block] = prefix;
		prefix += blockSums[block];
	}
}
