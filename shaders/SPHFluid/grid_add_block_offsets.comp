#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 6) buffer CellOffsetBuffer { uint cellOffsets[]; };
layout(std430, binding = 9) readonly buffer BlockOffsetBuffer { uint blockOffsets[]; };

uniform uint uCellCount;

void main()
{
	uint cell = gl_GlobalInvocationID.x;
	if (cell < uCellCount)
		cellOffsets[cell] += blockOffsets[cell / 256u];
}
