#version 430

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer PositionBuffer
{
	vec4 positions[];
};

layout(std430, binding = 1) readonly buffer VelocityBuffer
{
	vec4 velocities[];
};

layout(std430, binding = 2) writeonly buffer AccelerationBuffer
{
	vec4 accelerations[];
};

layout(std430, binding = 3) readonly buffer DensityBuffer
{
	float densities[];
};

layout(std430, binding = 4) readonly buffer PressureBuffer
{
	float pressures[];
};

uniform uint uParticleCount;
uniform float uSmoothingRadius;
uniform float uParticleMass;
uniform float uViscosity;
uniform vec3 uGravity;

const float PI = 3.14159265358979323846;

void main()
{
	const uint i = gl_GlobalInvocationID.x;
	if (i >= uParticleCount)
		return;

	const float h2 = uSmoothingRadius * uSmoothingRadius;
	const float h3 = h2 * uSmoothingRadius;
	const float h6 = h3 * h3;
	const float spiky_gradient_coefficient = -45.0 / (PI * h6);
	const float viscosity_laplacian_coefficient = 45.0 / (PI * h6);
	const vec3 position_i = positions[i].xyz;
	const vec3 velocity_i = velocities[i].xyz;
	const float density_i = densities[i];
	const float pressure_i = pressures[i];
	vec3 acceleration = uGravity;

	for (uint j = 0u; j < uParticleCount; ++j) {
		if (i == j)
			continue;
		const vec3 displacement = position_i - positions[j].xyz;
		const float squared_distance = dot(displacement, displacement);
		if (!(squared_distance < h2) || squared_distance <= 1.0e-12)
			continue;

		const float distance = sqrt(squared_distance);
		const float difference = uSmoothingRadius - distance;
		const vec3 pressure_gradient = spiky_gradient_coefficient *
		                               difference * difference *
		                               (displacement / distance);
		const float pressure_scale =
			-uParticleMass * (pressure_i + pressures[j]) /
			(2.0 * density_i * densities[j]);
		acceleration += pressure_scale * pressure_gradient;

		const float viscosity_scale =
			uViscosity * uParticleMass * viscosity_laplacian_coefficient *
			difference / (density_i * densities[j]);
		acceleration += viscosity_scale * (velocities[j].xyz - velocity_i);
	}

	accelerations[i] = vec4(acceleration, 0.0);
}
